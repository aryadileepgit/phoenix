# ==============================
# Phoenix ML artifacts
# Ignore model artifacts by default
# ==============================
backend/storage/models/*

# Include the active model directory
!backend/storage/models/f99a1cac-51a4-4d18-9b82-a06d975dd97b/

# Ignore everything inside the active model directory by default
backend/storage/models/f99a1cac-51a4-4d18-9b82-a06d975dd97b/*

# Include model artifacts required for deployment
!backend/storage/models/f99a1cac-51a4-4d18-9b82-a06d975dd97b/phoenix_xgboost_model.joblib
!backend/storage/models/f99a1cac-51a4-4d18-9b82-a06d975dd97b/model_metadata.json
!backend/storage/models/f99a1cac-51a4-4d18-9b82-a06d975dd97b/model_features.json
!backend/storage/models/f99a1cac-51a4-4d18-9b82-a06d975dd97b/feature_medians.json
!backend/storage/seed_data.json

# Ignore other generated ML artifacts
backend/storage/graphs/
backend/storage/preprocessing_models/

