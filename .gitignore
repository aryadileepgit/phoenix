# Logs and temporary files
# ==============================
*.log
tmp/
temp/

# Include IEEE-CIS preprocessing artifacts required by the scoring service
!backend/storage/preprocessing_models/
!backend/storage/preprocessing_models/ieee_cis_preprocessor.joblib
!backend/storage/preprocessing_models/ieee_cis_feature_metadata.joblib