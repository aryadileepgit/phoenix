{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/pages/DatasetOverview.tsx",
    "src/pages/FraudRisk.tsx",
    "src/pages/FraudDetection.tsx",
    "src/pages/SHAPExplanation.tsx",
    "src/pages/Simulator.tsx",
    "src/pages/Welcome.tsx",
    "src/pages/Login.tsx",
    "src/components/fraud/PredictionCard.tsx",
    "src/components/fraud/TransactionUploadCard.tsx",
    "src/components/fraud/BatchResultsPanel.tsx",
    "src/components/fraud/ModelPerformanceCard.tsx",
    "src/components/dataset/DatasetPreview.tsx",
    "src/components/dataset/DatasetInfoCard.tsx",
    "src/components/dataset/ActivityTimeline.tsx",
    "src/components/dataset/CleaningCard.tsx",
    "src/components/dataset/DatasetOverview.tsx",
    "src/components/dataset/FeatureEngineeringCard.tsx",
    "src/components/dataset/FooterSummary.tsx",
    "src/components/dataset/PipelineProgress.tsx",
    "src/components/dataset/PreprocessingCard.tsx",
    "src/components/dataset/SmoteCard.tsx",
    "src/components/dataset/StatisticsCards.tsx",
    "src/components/dataset/StorageFlow.tsx",
    "src/components/dataset/TrainTestSplitCard.tsx",
    "src/components/dataset/ValidationCard.tsx",
    "src/components/dataset/UploadCard.tsx",
    "src/components/dataset/ReportsSummary.tsx",
    "src/components/dataset/DatasetHistory.tsx",
    "src/components/transactions/TransactionDetailDrawer.tsx",
    "src/components/dataset/DatasetInfoCards.tsx",
    "src/components/dataset/DataPreviewTable.tsx"
  ]
}