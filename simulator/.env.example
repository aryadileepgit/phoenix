# PHOENIX simulator environment configuration.
# Copy to .env (loaded only if you add python-dotenv) or export
# these variables in your shell before running
# transaction_generator.py. All values have safe defaults.
#
# Direct HTTP scoring fallback (used when Kafka is disabled or
# the broker is unreachable).
PHOENIX_API_URL=http://127.0.0.1:1992
TRANSACTION_INTERVAL_SECONDS=5
ACCOUNT_HISTORY_FILE=account_history.json
#
# Kafka transport: Simulator -> phoenix-transactions topic.
# Set KAFKA_ENABLED=false to always score via direct HTTP POST.
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=phoenix-transactions
#
# Demo Suspicious Mode: periodically layer realistic,
# calibrated suspicious IEEE-CIS patterns over normal
# traffic for demonstrations. The trained XGBoost model
# always determines the final fraud probability, risk,
# and decision — nothing here hardcodes model outputs.
# Calibrated live: ~1 HIGH and ~3 MEDIUM per 500 txns.
DEMO_SUSPICIOUS_MODE=true
DEMO_HIGH_PROB=0.002
DEMO_MEDIUM_PROB=0.006
# DEMO_SEED=7  (optional: reproducible demo rates)
#
# LIVELY DEMO PRESET: the calibrated defaults above yield
# ~1 HIGH + ~3 MEDIUM per 500 transactions, so short runs
# mostly show uniform normal traffic (the model is flat
# across normal inputs by design). For a visible demo, use:
# DEMO_HIGH_PROB=0.02
# DEMO_MEDIUM_PROB=0.08
# (~1 HIGH + ~4 MEDIUM per 50 transactions; every event
# still carries unique randomized values and the model —
# never this file — decides each outcome.)
