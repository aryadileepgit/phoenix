# PHOENIX backend environment configuration.
# Copy to .env and fill in real values. Never commit .env.
#
# PostgreSQL connection string used by app/database/database.py
# Example: postgresql+psycopg2://USER:PASSWORD@localhost:5432/phoenix_db
# On Render, this is automatically provided by the database service
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/phoenix_db
#
# JWT Secret for signing tokens (generate a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
#
# Google Gemini API key used by app/services/gemini_schema_mapper.py
# for AI-assisted schema mapping. If unset/empty, schema mapping
# must fall back to registry/heuristic matching instead of crashing.
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# Kafka consumer (backend/kafka_consumer.py) for the
# `phoenix-transactions` topic.
# On Render, use Upstash Kafka (https://upstash.com) - free tier: 10k msg/day
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=phoenix-transactions
KAFKA_GROUP_ID=phoenix-scoring-group
#
# Upstash Kafka REST API (for producer)
UPSTASH_KAFKA_REST_URL=
UPSTASH_KAFKA_REST_USERNAME=
UPSTASH_KAFKA_REST_PASSWORD=
#
# Email service for password reset.
# Set EMAIL_ENABLED=true and configure SMTP to send real emails.
# If false/unset, tokens are logged to console (dev mode).
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="Phoenix <noreply@yourdomain.com>"
EMAIL_BASE_URL=http://localhost:5173

# JWT Settings
JWT_SECRET=
JWT_EXPIRE_MINUTES=480